FROM mcr.microsoft.com/openjdk/jdk:21-ubuntu@sha256:f89b256658018e9a591f64b396a1dd82978af20b9a52605c0185a77c95a10eb0 AS build
ARG TARGET_E2E_SOURCE_SHA
WORKDIR /workspace

COPY .mvn ./.mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw
RUN ./mvnw -s .mvn/settings.xml -B -ntp -Ptarget-e2e dependency:go-offline

COPY src ./src
RUN ./mvnw -s .mvn/settings.xml -B -ntp -Ptarget-e2e \
    -Dmaven.test.skip=true \
    -Dtarget-e2e.skip-unit-tests=true \
    -Dtarget-e2e.source-sha="${TARGET_E2E_SOURCE_SHA}" \
    clean package

FROM mcr.microsoft.com/openjdk/jdk:21-ubuntu@sha256:f89b256658018e9a591f64b396a1dd82978af20b9a52605c0185a77c95a10eb0
WORKDIR /home/app

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=app:app /workspace/target/java-api-service-0.1.0-SNAPSHOT.jar /home/app/app-main.jar
COPY --from=build --chown=app:app /workspace/target/java-api-service-0.1.0-SNAPSHOT-target-e2e.jar /home/app/app-target-e2e.jar

ENV SPRING_PROFILES_ACTIVE=target-e2e,agent-worker \
    APP_AGENT_RUN_V2_ENABLED=true \
    APP_AGENT_RUN_V2_PROTOCOL_DEFAULT=V2 \
    APP_AGENT_RUN_V2_SCHEDULER_MODE=DETECTOR

USER app
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=45s --retries=12 \
    CMD curl --fail --silent http://127.0.0.1:8080/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0"]
CMD ["-jar", "/home/app/app-target-e2e.jar"]
