# Project
COMPOSE_PROJECT_NAME=order-fulfillment-dispute-system
APP_ENV=local
TZ=Asia/Shanghai

# LLM / Qwen / LiteLLM
DASHSCOPE_API_KEY=__PASTE_YOUR_DASHSCOPE_API_KEY_HERE__
DEFAULT_LLM_PROVIDER=litellm
DEFAULT_LLM_MODEL=qwen3.7-plus
DEFAULT_LLM_API_BASE=https://ws-veazvl2fycrurdmv.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_ENABLE_THINKING=false
LITELLM_MASTER_KEY=__GENERATED_BY_CODEX__
LITELLM_SALT_KEY=__GENERATED_BY_CODEX__
LITELLM_BASE_URL=http://litellm-proxy:4000
LITELLM_DEFAULT_MODEL=qwen3.7-plus

# PostgreSQL
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=15432
POSTGRES_DB=dispute_system
POSTGRES_USER=__GENERATED_BY_CODEX__
POSTGRES_PASSWORD=__GENERATED_BY_CODEX__
JAVA_DB_NAME=dispute_system
JAVA_DB_USER=dispute_app
JAVA_DB_PASSWORD=__GENERATED_BY_CODEX__
TEMPORAL_DB_NAME=temporal
TEMPORAL_DB_USER=temporal_app
TEMPORAL_DB_PASSWORD=__GENERATED_BY_CODEX__
LANGFUSE_DB_NAME=langfuse
LANGFUSE_DB_USER=langfuse_app
LANGFUSE_DB_PASSWORD=__GENERATED_BY_CODEX__
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm_app
LITELLM_DB_PASSWORD=__GENERATED_BY_CODEX__
GRAPH_DB_NAME=dispute_graph
GRAPH_DB_SCHEMA=graph_runtime
GRAPH_OWNER_USER=graph_owner
GRAPH_MIGRATOR_USER=graph_migrator
GRAPH_MIGRATOR_PASSWORD=__GENERATED_BY_CODEX__
GRAPH_RUNTIME_USER=graph_runtime
GRAPH_RUNTIME_PASSWORD=__GENERATED_BY_CODEX__
GRAPH_RETENTION_USER=graph_retention
GRAPH_RETENTION_PASSWORD=__GENERATED_BY_CODEX__
GRAPH_DB_ENVIRONMENT_GENERATION=__GENERATED_BY_CODEX__
GRAPH_DB_RESTORE_VERIFICATION_HASH=__GENERATED_BY_CODEX__

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=16379
REDIS_PASSWORD=__GENERATED_BY_CODEX__

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_HOST_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_CONSOLE_ENDPOINT=http://localhost:19001
MINIO_ROOT_USER=__GENERATED_BY_CODEX__
MINIO_ROOT_PASSWORD=__GENERATED_BY_CODEX__
MINIO_BUCKET_EVIDENCE_ORIGINAL=evidence-original
MINIO_BUCKET_EVIDENCE_DESENSITIZED=evidence-desensitized
MINIO_BUCKET_OCR_TEMP=ocr-temp
MINIO_BUCKET_POLICY_FILES=policy-files
MINIO_BUCKET_REVIEW_EXPORTS=review-exports

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_HOST_PORT=19200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=__GENERATED_BY_CODEX__
ELASTICSEARCH_SECURITY_ENABLED=false

# Temporal
TEMPORAL_ADDRESS=temporal-server:7233
TEMPORAL_HOST_PORT=7233
TEMPORAL_NAMESPACE=default
# Existing EvidenceWindow histories remain on this compatibility queue until REL-010 passes.
TEMPORAL_TASK_QUEUE=case-dispute-task-queue
# Local auto-setup 1.25 uses NONE. Production must select BUILD_ID or DEPLOYMENT
# only after the corresponding versions are registered and promoted.
TEMPORAL_WORKER_VERSIONING_MODE=NONE
TEMPORAL_CONTROL_DEPLOYMENT_NAME=after-sale-control
TEMPORAL_CONTROL_BUILD_ID=local-dev
TEMPORAL_AGENT_DEPLOYMENT_NAME=after-sale-agent
TEMPORAL_AGENT_BUILD_ID=local-dev
# Custom attributes must be registered in the namespace before enabling writes.
TEMPORAL_SEARCH_ATTRIBUTES_ENABLED=false
# Roll out DISABLED -> DECRYPT_ONLY -> ENCRYPT; key material comes from KMS/Vault.
TEMPORAL_PAYLOAD_CODEC_MODE=DISABLED
TEMPORAL_PAYLOAD_CODEC_ACTIVE_KEY_ID=
TEMPORAL_PAYLOAD_CODEC_ACTIVE_KEY_BASE64=

# OpenTelemetry. Phase 8 supplies the HA collector topology; local export is opt-in.
OTEL_TRACING_ENABLED=false
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=10s

# Langfuse
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PORT=13000
LANGFUSE_PUBLIC_KEY=__GENERATED_BY_CODEX__
LANGFUSE_SECRET_KEY=__GENERATED_BY_CODEX__
LANGFUSE_SALT=__GENERATED_BY_CODEX__
LANGFUSE_NEXTAUTH_SECRET=__GENERATED_BY_CODEX__
LANGFUSE_NEXTAUTH_URL=http://localhost:13000

# Java API Service
JAVA_API_PORT=8080
JAVA_API_INTERNAL_PORT=8080
JAVA_API_SERVICE_URL=http://java-api-service:8080
JAVA_RUNTIME_IMAGE=after-sale-flow/java-runtime:local
APP_AGENT_TIMEOUT_MS=300000
JAVA_SERVICE_SECRET=__GENERATED_BY_CODEX__
APP_TENANT_SURROGATE=legacy-default
APP_ORCHESTRATION_COMMAND_V1_ENABLED=false
APP_ORCHESTRATION_NEW_EPOCH_MODE=LEGACY
APP_ORCHESTRATION_NON_LEGACY_EPOCH_ALLOCATION_ENABLED=false
APP_ORCHESTRATION_TEMPORAL_WRITER_ENABLED=false
APP_ORCHESTRATION_COMMAND_OUTBOX_ENABLED=false
APP_ORCHESTRATION_COMMAND_OUTBOX_BATCH_SIZE=32
APP_ORCHESTRATION_COMMAND_OUTBOX_LEASE_DURATION=PT1M
APP_ORCHESTRATION_COMMAND_OUTBOX_BASE_BACKOFF=PT1S
APP_ORCHESTRATION_COMMAND_OUTBOX_MAX_BACKOFF=PT5M
APP_ORCHESTRATION_COMMAND_OUTBOX_POLL_INTERVAL=PT5S
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_ENABLED=false
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_BATCH_SIZE=32
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_CONCURRENCY=32
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_LEASE_DURATION=PT2M
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_COMPLETION_TIMEOUT=PT90S
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_BASE_BACKOFF=PT1S
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_MAX_BACKOFF=PT5M
APP_ORCHESTRATION_ROOM_EPOCH_BOOTSTRAP_POLL_INTERVAL=PT5S
APP_ORCHESTRATION_DOMAIN_EVENT_RECOVERY_ENABLED=false
APP_ORCHESTRATION_DOMAIN_EVENT_RECOVERY_WORKFLOW_BATCH_SIZE=32
APP_ORCHESTRATION_DOMAIN_EVENT_RECOVERY_EVENT_BATCH_SIZE=64
APP_ORCHESTRATION_DOMAIN_EVENT_RECOVERY_CLAIM_DURATION=PT5M
APP_ORCHESTRATION_DOMAIN_EVENT_RECOVERY_POLL_INTERVAL=PT5S
APP_ORCHESTRATION_PROJECTION_RECONCILIATION_ENABLED=false
APP_ORCHESTRATION_PROJECTION_RECONCILIATION_BATCH_SIZE=32
APP_ORCHESTRATION_PROJECTION_RECONCILIATION_CLAIM_DURATION=PT5M
APP_ORCHESTRATION_PROJECTION_RECONCILIATION_POLL_INTERVAL=PT30S
EVIDENCE_WINDOW=PT2H
HEARING_WINDOW=PT3H
HEARING_PARTY_STAGE_WINDOW=PT20M
SSE_HEARTBEAT=PT15S
SEED_DEMO_DISPUTES=false

# Python Agent Service
PYTHON_AGENT_PORT=18000
PYTHON_AGENT_INTERNAL_PORT=8000
PYTHON_AGENT_SERVICE_URL=http://python-agent-service:8000
PYTHON_AGENT_SERVICE_SECRET=__GENERATED_BY_CODEX__
GRAPH_GATEWAY_MODE=DISABLED
GRAPH_JWKS_URL=http://java-api-service:8080/.well-known/graph-jwks.json
GRAPH_EXPECTED_SPIFFE_ID=spiffe://after-sale-flow/java-api-service
GRAPH_SHADOW_BINDINGS=[]
GRAPH_SHADOW_THREADS=[]
APP_GRAPH_JWKS_ENABLED=false
GRAPH_PUBLIC_KEYS_HOST_DIRECTORY=./.runtime/graph-public-keys
APP_AGENT_RUN_V2_GRAPH_CLIENT_MODE=DISABLED
APP_AGENT_RUN_V2_GRAPH_CLIENT_BASE_URI=https://python-agent-service:8000
APP_AGENT_RUN_V2_GRAPH_CLIENT_ALLOW_PLAINTEXT_TRANSPORT=false
GRAPH_SIGNING_KEYS_HOST_DIRECTORY=./.runtime/graph-signing-keys
APP_AGENT_RUN_V2_GRAPH_SIGNING_ACTIVE_KEY_ID=
GRAPH_MTLS_HOST_DIRECTORY=./.runtime/graph-mtls
APP_AGENT_RUN_V2_GRAPH_TLS_KEY_STORE_PASSWORD=__GENERATED_BY_CODEX__
APP_AGENT_RUN_V2_GRAPH_TLS_TRUST_STORE_PASSWORD=__GENERATED_BY_CODEX__
APP_AGENT_RUN_V2_GRAPH_BINDING_GRAPH_KEY=
APP_AGENT_RUN_V2_GRAPH_BINDING_GRAPH_VERSION=
APP_AGENT_RUN_V2_GRAPH_BINDING_CHECKPOINT_SCHEMA_VERSION=
APP_AGENT_RUN_V2_GRAPH_BINDING_AGENT_PROFILE_ID=
APP_AGENT_RUN_V2_GRAPH_BINDING_PROMPT_PROFILE_ID=
APP_AGENT_RUN_V2_GRAPH_BINDING_MODEL_PROFILE_ID=
APP_AGENT_RUN_V2_GRAPH_BINDING_OUTPUT_SCHEMA_VERSION=
APP_AGENT_RUN_V2_GRAPH_BINDING_POLICY_VERSION=
APP_AGENT_RUN_V2_GRAPH_BINDING_GUARDRAIL_VERSION=
APP_AGENT_RUN_V2_GRAPH_BINDING_AUDIENCE=SYSTEM
APP_AGENT_RUN_V2_GRAPH_BINDING_REGISTRY_HASH=
APP_AGENT_RUN_V2_GRAPH_BINDING_TOOL_POLICY_VERSION=

# OCR Parser Service
OCR_SERVICE_PORT=18010
OCR_SERVICE_INTERNAL_PORT=8010
OCR_SERVICE_URL=http://ocr-parser-service:8010
OCR_SERVICE_SECRET=__GENERATED_BY_CODEX__

# Frontend / Nginx
FRONTEND_PORT=5173
NGINX_PORT=18080
VITE_API_BASE_URL=/api

# Optional image overrides for restricted registries.
# Keep these official defaults in normal environments.
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
REDIS_IMAGE=public.ecr.aws/docker/library/redis:7.2-alpine
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.4
ELASTICSEARCH_INIT_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.4
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-06-13T22-53-53Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2024-06-12T14-34-03Z
TEMPORAL_IMAGE=temporalio/auto-setup:1.25.2
LANGFUSE_IMAGE=ghcr.io/langfuse/langfuse:2.95.11
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.63.14-stable
NGINX_IMAGE=public.ecr.aws/docker/library/nginx:1.27-alpine

# Feature Flags
FEATURE_AGENT_INTAKE_ENABLED=true
FEATURE_AGENT_HEARING_ENABLED=true
FEATURE_AGENT_EVALUATION_ENABLED=true
FEATURE_OCR_ENABLED=true
FEATURE_HUMAN_REVIEW_REQUIRED=true
FEATURE_TOOL_EXECUTOR_SIMULATION=true
FEATURE_AUTO_CLOSE_ENABLED=true

# Security / Logging
LOG_LEVEL=INFO
ENABLE_REQUEST_LOG=true
ENABLE_AUDIT_LOG=true
ENABLE_SENSITIVE_LOG_MASKING=true
