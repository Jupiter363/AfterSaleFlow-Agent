{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/intake/v2/intake-turn-proposal.schema.json",
  "title": "Intake Turn Proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "command_id", "logical_run_id", "attempt_id", "case_id",
    "room_epoch", "thread_id", "actor_scope_hash", "agent_session_id",
    "cognitive_revision", "source_snapshot_hash", "room_utterance", "conversation_action",
    "dossier_patch",
    "readiness", "missing_fields", "recommendation", "knowledge_answer_mode",
    "confidence", "profile_versions", "proposal_hash"
  ],
  "properties": {
    "schema_version": {"const": "intake-turn-proposal.v2"},
    "command_id": {"$ref": "#/$defs/identifier"},
    "logical_run_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_epoch": {"type": "integer", "minimum": 0},
    "thread_id": {"$ref": "#/$defs/thread_id"},
    "actor_scope_hash": {"$ref": "#/$defs/sha256"},
    "agent_session_id": {"$ref": "#/$defs/identifier"},
    "cognitive_revision": {"type": "integer", "minimum": 1},
    "source_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "source_event_hash": {"$ref": "#/$defs/sha256"},
    "room_utterance": {"type": "string", "minLength": 1, "maxLength": 20000},
    "conversation_action": {
      "enum": [
        "ASK_SUBSTANTIVE", "INVITE_OPTIONAL_REMARK", "ACK_REMARK", "ACK_NO_REMARK"
      ]
    },
    "dossier_patch": {"$ref": "#/$defs/dossier_patch"},
    "matrix_patch": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/unilateral_matrix_draft"},
        {"$ref": "#/$defs/case_matrix_delta"}
      ]
    },
    "readiness": {"enum": ["INCOMPLETE", "READY_TO_CONFIRM", "NEEDS_REVIEW"]},
    "missing_fields": {
      "type": "array", "maxItems": 30, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "recommendation": {"enum": ["ACCEPTED", "NEED_MORE_INFO", "NOT_ADMISSIBLE"]},
    "knowledge_answer_mode": {"enum": ["NONE", "STUB"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "profile_versions": {"$ref": "#/$defs/profile_versions"},
    "proposal_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thread_id": {"type": "string", "pattern": "^grt\\.v1\\.[0-9a-f]{32}$"},
    "bounded_branch": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"not": {"$ref": "#/$defs/forbidden_key"}},
      "additionalProperties": {"$ref": "#/$defs/safe_json"}
    },
    "safe_json": {
      "oneOf": [
        {"type": "string", "maxLength": 20000},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/safe_json"}
        },
        {"$ref": "#/$defs/bounded_branch"}
      ]
    },
    "forbidden_key": {
      "enum": [
        "memory_frame", "internal_handoff", "hidden_reasoning",
        "chain_of_thought", "tool_calls", "tool_parameters", "writer_mode",
        "credentials", "credential", "password", "api_key", "access_token",
        "refresh_token", "authorization_header", "private_key", "client_secret",
        "raw_audit_records", "audit_records", "reviewer_notes",
        "other_party_private_messages", "opposing_party_private_messages",
        "private_conversation", "internal_notes", "opposing_party_messages",
        "opposing_party_private", "other_party_messages", "other_party_private",
        "trusted_model_profile", "prompt_version", "model_profile_id", "policy_version",
        "guardrail_version", "tool_policy_version",
        "open_evidence", "complete_party", "send_summons", "execute_tool",
        "process_state", "case_status", "room_transition", "evidence_deadline",
        "review_instructions", "tool_instructions", "admit_case", "cancel_case",
        "cancel_intake", "freeze_matrix", "open_room", "set_deadline",
        "invite_participant"
      ]
    },
    "dossier_patch": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 18,
      "properties": {
        "schema_version": {
          "enum": ["intake-dossier.v2", "intake_case_detail.v1"]
        },
        "case_story": {"$ref": "#/$defs/bounded_branch"},
        "references": {"$ref": "#/$defs/bounded_branch"},
        "party_positions": {"$ref": "#/$defs/bounded_branch"},
        "dispute_focus": {"$ref": "#/$defs/bounded_branch"},
        "requested_resolution": {"$ref": "#/$defs/bounded_branch"},
        "claim_resolution": {"$ref": "#/$defs/bounded_branch"},
        "respondent_attitude": {"$ref": "#/$defs/bounded_branch"},
        "dispute_core_state": {"$ref": "#/$defs/bounded_branch"},
        "risk_assessment": {"$ref": "#/$defs/bounded_branch"},
        "missing_information": {"$ref": "#/$defs/bounded_branch"},
        "intake_quality": {"$ref": "#/$defs/bounded_branch"},
        "admission": {"$ref": "#/$defs/bounded_branch"},
        "handoff_notes": {"$ref": "#/$defs/bounded_branch"},
        "party_intake_state": {"$ref": "#/$defs/party_intake_state"},
        "handoff_remark_partition": {"$ref": "#/$defs/handoff_remark_partition"}
      }
    },
    "handoff_remark_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "case_fact_matrix_id", "case_fact_matrix_version",
        "case_fact_matrix_hash", "parties"
      ],
      "properties": {
        "schema_version": {"const": "handoff_remark_partition.v1"},
        "case_fact_matrix_id": {"$ref": "#/$defs/identifier"},
        "case_fact_matrix_version": {"type": "integer", "minimum": 1},
        "case_fact_matrix_hash": {"$ref": "#/$defs/sha256"},
        "parties": {"$ref": "#/$defs/handoff_remark_parties"}
      }
    },
    "handoff_remark_parties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["USER", "MERCHANT"],
      "properties": {
        "USER": {"$ref": "#/$defs/handoff_remark_user_party"},
        "MERCHANT": {"$ref": "#/$defs/handoff_remark_merchant_party"}
      }
    },
    "handoff_remark_user_party": {
      "allOf": [
        {"$ref": "#/$defs/handoff_remark_party"},
        {"properties": {"party_role": {"const": "USER"}}}
      ]
    },
    "handoff_remark_merchant_party": {
      "allOf": [
        {"$ref": "#/$defs/handoff_remark_party"},
        {"properties": {"party_role": {"const": "MERCHANT"}}}
      ]
    },
    "handoff_remark_party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party_role", "remark_status", "latest_remark", "remarks"],
      "properties": {
        "party_role": {"enum": ["USER", "MERCHANT"]},
        "remark_status": {
          "enum": [
            "NOT_READY", "READY_PENDING_REMARK_INVITE", "WAITING_FOR_REMARK",
            "HAS_REMARKS", "NO_EXTRA_REMARKS"
          ]
        },
        "source": {"$ref": "#/$defs/handoff_remark_source"},
        "latest_remark": {"type": "string", "maxLength": 8192},
        "remarks": {
          "type": "array", "maxItems": 128,
          "items": {"$ref": "#/$defs/handoff_remark_entry"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"remark_status": {"const": "NOT_READY"}}},
          "then": {
            "not": {"required": ["source"]},
            "properties": {
              "latest_remark": {"const": ""},
              "remarks": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "remark_status": {
                "enum": [
                  "READY_PENDING_REMARK_INVITE", "WAITING_FOR_REMARK",
                  "NO_EXTRA_REMARKS"
                ]
              }
            }
          },
          "then": {
            "required": ["source"],
            "properties": {
              "latest_remark": {"const": ""},
              "remarks": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"remark_status": {"const": "HAS_REMARKS"}}},
          "then": {
            "required": ["source"],
            "properties": {
              "source": {"$ref": "#/$defs/room_message_remark_source"},
              "latest_remark": {"minLength": 1},
              "remarks": {"minItems": 1}
            }
          }
        }
      ]
    },
    "handoff_remark_source": {
      "oneOf": [
        {"$ref": "#/$defs/room_message_remark_source"},
        {"$ref": "#/$defs/formal_confirmation_remark_source"}
      ]
    },
    "room_message_remark_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "message_id", "message_hash"],
      "properties": {
        "source_kind": {"const": "ROOM_MESSAGE"},
        "message_id": {"$ref": "#/$defs/identifier"},
        "message_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "formal_confirmation_remark_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "command_id", "request_hash"],
      "properties": {
        "source_kind": {"const": "FORMAL_CONFIRMATION"},
        "command_id": {"$ref": "#/$defs/identifier"},
        "request_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "handoff_remark_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "party_role", "text", "source_message_id", "source_message_hash", "turn_source"
      ],
      "properties": {
        "party_role": {"enum": ["USER", "MERCHANT"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 8192},
        "source_message_id": {"$ref": "#/$defs/identifier"},
        "source_message_hash": {"$ref": "#/$defs/sha256"},
        "turn_source": {"const": "ROOM_MESSAGE"}
      }
    },
    "party_intake_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "USER", "MERCHANT"],
      "properties": {
        "schema_version": {"const": "party-intake-state.v1"},
        "USER": {"$ref": "#/$defs/party_intake_user_entry"},
        "MERCHANT": {"$ref": "#/$defs/party_intake_merchant_entry"}
      }
    },
    "party_intake_user_entry": {
      "allOf": [
        {"$ref": "#/$defs/party_intake_entry"},
        {
          "properties": {
            "handoff_notes": {
              "properties": {
                "remarks": {
                  "items": {
                    "properties": {"role": {"const": "USER"}}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "party_intake_merchant_entry": {
      "allOf": [
        {"$ref": "#/$defs/party_intake_entry"},
        {
          "properties": {
            "handoff_notes": {
              "properties": {
                "remarks": {
                  "items": {
                    "properties": {"role": {"const": "MERCHANT"}}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "party_intake_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intake_quality", "missing_information", "handoff_notes", "admission"],
      "properties": {
        "intake_quality": {"$ref": "#/$defs/party_intake_quality"},
        "missing_information": {"$ref": "#/$defs/party_missing_information"},
        "handoff_notes": {"$ref": "#/$defs/party_handoff_notes"},
        "admission": {"$ref": "#/$defs/party_admission"}
      }
    },
    "party_intake_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score", "threshold", "ready_for_next_step", "score_breakdown", "improvement_reason"
      ],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "threshold": {"const": 85},
        "ready_for_next_step": {"type": "boolean"},
        "score_breakdown": {"$ref": "#/$defs/party_intake_score_breakdown"},
        "improvement_reason": {"type": "string", "maxLength": 20000}
      }
    },
    "party_intake_score_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "references", "event_story", "party_positions", "requested_resolution",
        "risk_and_conflicts", "next_action_clarity"
      ],
      "properties": {
        "references": {"type": "integer", "minimum": 0, "maximum": 15},
        "event_story": {"type": "integer", "minimum": 0, "maximum": 20},
        "party_positions": {"type": "integer", "minimum": 0, "maximum": 20},
        "requested_resolution": {"type": "integer", "minimum": 0, "maximum": 15},
        "risk_and_conflicts": {"type": "integer", "minimum": 0, "maximum": 15},
        "next_action_clarity": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "party_missing_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_gaps", "nice_to_have_gaps", "next_questions"],
      "properties": {
        "blocking_gaps": {"$ref": "#/$defs/party_string_list"},
        "nice_to_have_gaps": {"$ref": "#/$defs/party_string_list"},
        "next_questions": {"$ref": "#/$defs/party_string_list"}
      }
    },
    "party_string_list": {
      "type": "array",
      "maxItems": 128,
      "items": {"type": "string", "maxLength": 20000}
    },
    "party_handoff_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remark_status", "phase_source_message_id", "latest_remark", "remarks", "instruction"
      ],
      "properties": {
        "remark_status": {
          "enum": [
            "NOT_READY", "READY_PENDING_REMARK_INVITE", "WAITING_FOR_REMARK",
            "HAS_REMARKS", "NO_EXTRA_REMARKS"
          ]
        },
        "phase_source_message_id": {"type": "string", "maxLength": 20000},
        "latest_remark": {"type": "string", "maxLength": 20000},
        "remarks": {
          "type": "array",
          "maxItems": 128,
          "items": {"$ref": "#/$defs/party_remark"}
        },
        "instruction": {"type": "string", "maxLength": 20000}
      }
    },
    "party_remark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "text", "source_message_id", "turn_source"],
      "properties": {
        "role": {"enum": ["USER", "MERCHANT"]},
        "text": {"type": "string", "maxLength": 20000},
        "source_message_id": {"type": "string", "maxLength": 20000},
        "turn_source": {"type": "string", "maxLength": 20000}
      }
    },
    "party_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "reasoning", "confidence"],
      "properties": {
        "recommendation": {"enum": ["NEED_MORE_INFO", "ACCEPTED", "NOT_ADMISSIBLE"]},
        "reasoning": {"type": "string", "maxLength": 20000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "unilateral_matrix_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "fact_rows", "summary_source_fact_keys"],
      "properties": {
        "schema_version": {"const": "unilateral_case_matrix.draft.v1"},
        "fact_rows": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {"$ref": "#/$defs/unilateral_fact_draft"}
        },
        "summary_source_fact_keys": {
          "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": {"$ref": "#/$defs/fact_key"}
        }
      }
    },
    "unilateral_fact_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_key", "category", "fact_target", "materiality",
        "position_summary", "asserted_value", "source_scope"
      ],
      "properties": {
        "fact_key": {"$ref": "#/$defs/fact_key"},
        "category": {"enum": [
          "ORDER", "PRODUCT_PAGE", "PAYMENT", "FULFILLMENT", "LOGISTICS",
          "PRODUCT_STATE", "COMMUNICATION", "AFTER_SALES", "TIME", "OTHER"
        ]},
        "fact_target": {"type": "string", "minLength": 1, "maxLength": 20000},
        "materiality": {"enum": ["CORE", "SUPPORTING", "CONTEXT"]},
        "position_summary": {"type": "string", "minLength": 1, "maxLength": 20000},
        "asserted_value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_scope": {"enum": [
          "CURRENT_SOURCE", "PREVIOUS_MATRIX", "PREVIOUS_AND_CURRENT_SOURCE"
        ]}
      }
    },
    "case_matrix_delta": {
      "type": "object",
      "additionalProperties": false,
      "x-semantic-constraints": [
        {
          "id": "UNIQUE_FACT_KEYS",
          "rule": "fact_rows[*].fact_key values MUST be unique"
        },
        {
          "id": "SUMMARY_KEYS_REFERENCE_ROWS",
          "rule": "summary_source_fact_keys MUST be a subset of fact_rows[*].fact_key"
        }
      ],
      "required": ["schema_version", "fact_rows", "summary_source_fact_keys"],
      "properties": {
        "schema_version": {"const": "case_fact_matrix.delta.v2"},
        "fact_rows": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {"$ref": "#/$defs/case_fact_delta"}
        },
        "summary_source_fact_keys": {
          "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true,
          "items": {"$ref": "#/$defs/fact_key"}
        },
        "respondent_claim": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/respondent_claim_delta"}
          ]
        }
      }
    },
    "case_fact_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_key", "category", "fact_target", "materiality", "stance",
        "position_summary", "source_scope"
      ],
      "properties": {
        "fact_key": {"$ref": "#/$defs/fact_key"},
        "category": {"enum": [
          "ORDER", "PRODUCT_PAGE", "PAYMENT", "FULFILLMENT", "LOGISTICS",
          "PRODUCT_STATE", "COMMUNICATION", "AFTER_SALES", "TIME", "OTHER"
        ]},
        "fact_target": {"type": "string", "minLength": 1, "maxLength": 20000},
        "materiality": {"enum": ["CORE", "SUPPORTING", "CONTEXT"]},
        "stance": {"enum": ["CONFIRM", "DENY", "PARTIAL", "UNKNOWN", "NOT_ADDRESSED"]},
        "position_summary": {"type": "string", "minLength": 1, "maxLength": 20000},
        "asserted_value": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 2000}
          ]
        },
        "source_scope": {"enum": [
          "CURRENT_SOURCE", "PREVIOUS_MATRIX", "PREVIOUS_AND_CURRENT_SOURCE"
        ]},
        "agreed_statement": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 20000}
          ]
        },
        "conflict_summary": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 20000}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["stance"],
            "properties": {"stance": {"const": "NOT_ADDRESSED"}}
          },
          "then": {
            "properties": {
              "fact_key": {"pattern": "^FACT_[A-Za-z0-9_:-]{1,123}$"},
              "source_scope": {"const": "PREVIOUS_MATRIX"},
              "asserted_value": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "required": ["fact_key"],
            "properties": {"fact_key": {"pattern": "^NEW_"}}
          },
          "then": {
            "properties": {
              "stance": {"not": {"const": "NOT_ADDRESSED"}},
              "source_scope": {"not": {"const": "PREVIOUS_MATRIX"}}
            }
          }
        }
      ]
    },
    "respondent_claim_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attitude", "position_summary"],
      "properties": {
        "attitude": {"enum": [
          "AGREE", "PARTIALLY_AGREE", "DISAGREE", "ALTERNATIVE_PROPOSED",
          "NEED_MORE_INFO", "NOT_ADDRESSED"
        ]},
        "position_summary": {"type": "string", "minLength": 1, "maxLength": 20000},
        "alternative_proposal": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 20000}
          ]
        }
      }
    },
    "fact_key": {
      "type": "string",
      "pattern": "^(?:FACT_[A-Za-z0-9_:-]{1,123}|NEW_[A-Za-z0-9_:-]{1,123})$"
    },
    "profile_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_version", "checkpoint_schema_version", "prompt_version", "model_profile_id",
        "output_schema_version", "policy_version", "guardrail_version", "tool_policy_version"
      ],
      "properties": {
        "graph_version": {"$ref": "#/$defs/identifier"},
        "checkpoint_schema_version": {"$ref": "#/$defs/identifier"},
        "prompt_version": {"$ref": "#/$defs/identifier"},
        "model_profile_id": {"$ref": "#/$defs/identifier"},
        "output_schema_version": {"const": "intake-turn-proposal.v2"},
        "policy_version": {"$ref": "#/$defs/identifier"},
        "guardrail_version": {"$ref": "#/$defs/identifier"},
        "tool_policy_version": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
