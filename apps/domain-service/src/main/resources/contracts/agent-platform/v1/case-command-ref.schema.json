{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/v1/case-command-ref.schema.json",
  "title": "CaseCommandRef v1",
  "description": "Durably accepted, authorized command reference delivered from Java to Temporal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "tenant_surrogate",
    "case_id",
    "case_command_sequence",
    "command_type",
    "room_type",
    "room_epoch",
    "actor_ref",
    "payload_ref",
    "expected_process_revision",
    "occurred_at",
    "deadline_at",
    "traceparent",
    "request_hash"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "case-command-ref.v1"},
    "command_id": {"$ref": "#/$defs/identifier"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "case_command_sequence": {"type": "integer", "minimum": 1},
    "command_type": {
      "type": "string",
      "enum": [
        "CASE_OPEN",
        "INTAKE_MESSAGE",
        "INTAKE_CONFIRM",
        "INTAKE_CANCEL",
        "EVIDENCE_SUBMIT",
        "PARTY_EVIDENCE_COMPLETE",
        "HEARING_STATEMENT",
        "HEARING_EVIDENCE_BATCH",
        "REVIEW_DECISION",
        "EXECUTE_APPROVED_PLAN",
        "CLOSE_CASE"
      ]
    },
    "room_type": {"type": "string", "enum": ["INTAKE", "EVIDENCE", "HEARING", "REVIEW"]},
    "room_epoch": {"type": "integer", "minimum": 0},
    "actor_ref": {"$ref": "#/$defs/actor_ref"},
    "payload_ref": {"$ref": "#/$defs/payload_ref"},
    "expected_process_revision": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "traceparent": {"$ref": "#/$defs/traceparent"},
    "request_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "actor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_role", "actor_scopes"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/identifier"},
        "actor_role": {
          "type": "string",
          "enum": ["USER", "MERCHANT", "PLATFORM_REVIEWER", "ADMIN", "SYSTEM"]
        },
        "actor_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "uri", "sha256", "size_bytes"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "format": "uri", "pattern": "^(s3|minio|urn):", "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}
      }
    }
  }
}
