{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/v1/agent-execution-manifest.schema.json",
  "title": "AgentExecutionManifest v1",
  "description": "Immutable provenance for a Java-finalized Agent artifact without hidden reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "tenant_surrogate",
    "case_id",
    "room_epoch",
    "process_revision",
    "fencing_token",
    "workflow",
    "agent_run",
    "graph",
    "model",
    "contract_versions",
    "policy_version",
    "guardrail_version",
    "tool_versions",
    "inputs",
    "output",
    "usage",
    "traceparent",
    "finalized_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "agent-execution-manifest.v1"},
    "manifest_id": {"$ref": "#/$defs/identifier"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_epoch": {"type": "integer", "minimum": 0},
    "process_revision": {"type": "integer", "minimum": 0},
    "fencing_token": {"type": "integer", "minimum": 0},
    "workflow": {"$ref": "#/$defs/workflow"},
    "agent_run": {"$ref": "#/$defs/agent_run"},
    "graph": {"$ref": "#/$defs/graph"},
    "model": {"$ref": "#/$defs/model"},
    "contract_versions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {"$ref": "#/$defs/identifier"}
    },
    "policy_version": {"$ref": "#/$defs/identifier"},
    "guardrail_version": {"$ref": "#/$defs/identifier"},
    "tool_versions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/artifact_pointer"}
    },
    "output": {"$ref": "#/$defs/artifact_pointer"},
    "usage": {"$ref": "#/$defs/usage"},
    "traceparent": {"$ref": "#/$defs/traceparent"},
    "finalized_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "run_id", "workflow_type", "build_id"],
      "properties": {
        "workflow_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "workflow_type": {"$ref": "#/$defs/identifier"},
        "build_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "agent_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_run_id", "attempt_id", "logical_idempotency_key"],
      "properties": {
        "logical_run_id": {"$ref": "#/$defs/identifier"},
        "attempt_id": {"$ref": "#/$defs/identifier"},
        "logical_idempotency_key": {"$ref": "#/$defs/identifier"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_key", "graph_version", "checkpoint_schema_version", "checkpoint_id", "cognitive_revision"],
      "properties": {
        "graph_key": {"$ref": "#/$defs/identifier"},
        "graph_version": {"$ref": "#/$defs/identifier"},
        "checkpoint_schema_version": {"$ref": "#/$defs/identifier"},
        "checkpoint_id": {"$ref": "#/$defs/identifier"},
        "cognitive_revision": {"type": "integer", "minimum": 0}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_version", "model_profile_id", "provider", "model", "request_hash", "response_hash"],
      "properties": {
        "prompt_version": {"$ref": "#/$defs/identifier"},
        "model_profile_id": {"$ref": "#/$defs/identifier"},
        "provider": {"$ref": "#/$defs/identifier"},
        "model": {"$ref": "#/$defs/identifier"},
        "request_hash": {"$ref": "#/$defs/sha256"},
        "response_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "schema_version", "uri", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "schema_version": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "format": "uri", "pattern": "^(s3|minio|urn):", "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "latency_ms"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
