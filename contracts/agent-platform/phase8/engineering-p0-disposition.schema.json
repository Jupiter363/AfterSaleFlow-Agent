{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aftersaleflow.example/contracts/agent-platform/phase8/engineering-p0-disposition.schema.json",
  "title": "Phase 8 engineering candidate P0 disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "additional_fields",
    "attestation_composite_sha256",
    "authority",
    "candidate",
    "command_contract",
    "contract_kind",
    "open_p0_count",
    "producer_identity",
    "review_lanes",
    "review_scope",
    "reviewed_topics",
    "repository",
    "repository_id",
    "schema_version",
    "self_approved",
    "self_seal",
    "status",
    "trusted_builder",
    "witness_artifact"
  ],
  "properties": {
    "additional_fields": { "const": "DENY" },
    "attestation_composite_sha256": { "$ref": "#/$defs/sha256" },
    "authority": { "$ref": "#/$defs/authority" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "command_contract": { "$ref": "#/$defs/commandContract" },
    "contract_kind": { "const": "PHASE8_ENGINEERING_CANDIDATE_P0_DISPOSITION" },
    "open_p0_count": { "const": 0 },
    "producer_identity": { "$ref": "#/$defs/identity" },
    "review_lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/reviewLane" }
    },
    "review_scope": { "const": "CONSOLIDATED_POST_INTEGRATION_P0_ONLY" },
    "reviewed_topics": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/topic" }
    },
    "repository": { "const": "Jupiter363/AfterSaleFlow-Agent" },
    "repository_id": { "const": "1282437633" },
    "schema_version": { "const": "phase8-engineering-p0-disposition.v1" },
    "self_approved": { "const": false },
    "self_seal": { "$ref": "#/$defs/selfSeal" },
    "status": { "const": "ALL_P0_CLOSED" },
    "trusted_builder": { "$ref": "#/$defs/trustedBuilder" },
    "witness_artifact": { "$ref": "#/$defs/witnessArtifact" }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\])[ !#-'()*+,./0-9;=@A-Z\\[\\]^_`a-z{}~-]+$"
    },
    "topic": {
      "enum": [
        "active-reference-authority",
        "scheduler-lifecycle",
        "capacity-admission",
        "recovery-rotation",
        "no-production-activation",
        "v046-additive-only",
        "stream-compatibility",
        "retention-archive",
        "redis-hint-only",
        "cleanup-eligibility",
        "topology-policy",
        "observability-privacy",
        "external-gate-fail-closed",
        "test-runtime-supply-chain",
        "evidence-attestation"
      ]
    },
    "pathBlob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "git_blob_sha", "mode", "path", "sha256"],
      "properties": {
        "change": { "enum": ["ADDED", "MODIFIED"] },
        "git_blob_sha": { "$ref": "#/$defs/sha1" },
        "mode": { "enum": ["100644", "100755"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_a8_sha",
        "changed_inventory",
        "changed_inventory_sha256",
        "commit_sha",
        "diff_sha256",
        "scope_inventory_sha256",
        "sole_parent_sha",
        "tree_sha"
      ],
      "properties": {
        "accepted_a8_sha": { "$ref": "#/$defs/sha1" },
        "changed_inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pathBlob" }
        },
        "changed_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "commit_sha": { "$ref": "#/$defs/sha1" },
        "diff_sha256": { "$ref": "#/$defs/sha256" },
        "scope_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "sole_parent_sha": { "$ref": "#/$defs/sha1" },
        "tree_sha": { "$ref": "#/$defs/sha1" }
      }
    },
    "blobBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_blob_sha", "path", "sha256"],
      "properties": {
        "git_blob_sha": { "$ref": "#/$defs/sha1" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "commandContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_blob_sha", "path", "payload_sha256", "sha256"],
      "properties": {
        "git_blob_sha": { "$ref": "#/$defs/sha1" },
        "path": { "const": "contracts/agent-platform/phase8/engineering-candidate-commands.json" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "trustedBuilder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trusted_code_blob_bundle",
        "trusted_code_sha",
        "trusted_code_tree_sha",
        "trusted_workflow_blob",
        "trusted_workflow_sha",
        "trusted_workflow_tree_sha"
      ],
      "properties": {
        "trusted_code_blob_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blobs", "sha256"],
          "properties": {
            "blobs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/blobBinding" }
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "trusted_code_sha": { "$ref": "#/$defs/sha1" },
        "trusted_code_tree_sha": { "$ref": "#/$defs/sha1" },
        "trusted_workflow_blob": {
          "allOf": [
            { "$ref": "#/$defs/blobBinding" },
            {
              "properties": {
                "path": { "const": ".github/workflows/phase8-engineering-witness.yml" }
              }
            }
          ]
        },
        "trusted_workflow_sha": { "$ref": "#/$defs/sha1" },
        "trusted_workflow_tree_sha": { "$ref": "#/$defs/sha1" }
      }
    },
    "witnessArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "MIG-006",
        "MIG-007",
        "MIG-008",
        "acceptance_key",
        "accepted",
        "accepted_a8_sha",
        "artifact",
        "attestation",
        "attestation_composite_sha256",
        "authority_ceiling",
        "caller_workflow_binding",
        "candidate_sha",
        "candidate_tree_sha",
        "command_artifact_set_sha256",
        "command_contract_payload_sha256",
        "event",
        "ledger_durability",
        "production_authority",
        "production_promotion",
        "repository",
        "repository_id",
        "run_attempt",
        "run_id",
        "schema_version",
        "signer_workflow",
        "source_ref",
        "scope_inventory_sha256",
        "trusted_code_sha",
        "trusted_code_tree_sha",
        "trusted_transition_sha256",
        "trusted_workflow_sha",
        "trusted_workflow_tree_sha"
      ],
      "properties": {
        "MIG-006": { "const": "PENDING_PROMOTION" },
        "MIG-007": { "const": "PENDING_PROMOTION" },
        "MIG-008": { "const": "PENDING_PROMOTION" },
        "acceptance_key": { "$ref": "#/$defs/sha256" },
        "accepted": { "const": true },
        "accepted_a8_sha": { "$ref": "#/$defs/sha1" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "sha256", "subject_filename"],
          "properties": {
            "id": { "type": "integer", "minimum": 1 },
            "name": { "type": "string", "pattern": "^phase8-engineering-witness-[1-9][0-9]*-[1-9][0-9]*$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "subject_filename": { "const": "phase8-engineering-witness.tar" }
          }
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_sha256", "certificate_sha256", "offline_verified", "online_verified", "predicate_authority", "predicate_sha256", "trusted_root_sha256", "verified_timestamps"],
          "properties": {
            "bundle_sha256": { "$ref": "#/$defs/sha256" },
            "certificate_sha256": { "$ref": "#/$defs/sha256" },
            "offline_verified": { "const": true },
            "online_verified": { "const": true },
            "predicate_authority": { "const": "BUILDER_CONTROLLED_UNTRUSTED_UNTIL_LOCAL_RECOMPUTE" },
            "predicate_sha256": { "$ref": "#/$defs/sha256" },
            "trusted_root_sha256": { "$ref": "#/$defs/sha256" },
            "verified_timestamps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["timestamp", "type", "uri"],
                "properties": {
                  "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
                  "type": { "const": "Tlog" },
                  "uri": { "const": "https://rekor.sigstore.dev" }
                }
              }
            }
          }
        },
        "attestation_composite_sha256": { "$ref": "#/$defs/sha256" },
        "authority_ceiling": { "const": "PHASE_8_ENGINEERING_CHECKPOINT_ONLY" },
        "caller_workflow_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_sha256", "git_blob_sha1", "mode", "path", "trusted_workflow_sha"],
          "properties": {
            "file_sha256": { "$ref": "#/$defs/sha256" },
            "git_blob_sha1": { "$ref": "#/$defs/sha1" },
            "mode": { "const": "100644" },
            "path": { "const": ".github/workflows/phase8-engineering-caller.yml" },
            "trusted_workflow_sha": { "$ref": "#/$defs/sha1" }
          }
        },
        "candidate_sha": { "$ref": "#/$defs/sha1" },
        "candidate_tree_sha": { "$ref": "#/$defs/sha1" },
        "command_artifact_set_sha256": { "$ref": "#/$defs/sha256" },
        "command_contract_payload_sha256": { "$ref": "#/$defs/sha256" },
        "event": { "const": "push" },
        "ledger_durability": { "const": "EXTERNAL_RUN_DIRECTORY_PLACEHOLDER_NOT_GLOBAL_REPLAY_AUTHORITY" },
        "production_authority": { "const": false },
        "production_promotion": { "const": "FORBIDDEN" },
        "repository": { "const": "Jupiter363/AfterSaleFlow-Agent" },
        "repository_id": { "const": "1282437633" },
        "run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "run_id": { "type": "integer", "minimum": 1 },
        "schema_version": { "const": "phase8-github-attestation-receipt.v1" },
        "signer_workflow": { "const": "Jupiter363/AfterSaleFlow-Agent/.github/workflows/phase8-engineering-witness.yml" },
        "source_ref": { "const": "refs/heads/codex/p8-production-hardening" },
        "scope_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "trusted_code_sha": { "$ref": "#/$defs/sha1" },
        "trusted_code_tree_sha": { "$ref": "#/$defs/sha1" },
        "trusted_transition_sha256": { "$ref": "#/$defs/sha256" },
        "trusted_workflow_sha": { "$ref": "#/$defs/sha1" },
        "trusted_workflow_tree_sha": { "$ref": "#/$defs/sha1" }
      }
    },
    "laneBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_a8_sha",
        "acceptance_key",
        "artifact_id",
        "artifact_name",
        "artifact_subject_filename",
        "artifact_subject_sha256",
        "attestation_composite_sha256",
        "caller_workflow_file_sha256",
        "caller_workflow_git_blob_sha1",
        "candidate_changed_inventory_sha256",
        "candidate_commit_sha",
        "candidate_diff_sha256",
        "candidate_scope_inventory_sha256",
        "candidate_sole_parent_sha",
        "candidate_tree_sha",
        "command_contract_git_blob_sha",
        "command_contract_payload_sha256",
        "command_contract_sha256",
        "command_artifact_set_sha256",
        "github_run_attempt",
        "github_run_id",
        "repository",
        "repository_id",
        "signer_workflow",
        "source_ref",
        "trusted_code_blob_bundle_sha256",
        "trusted_code_sha",
        "trusted_code_tree_sha",
        "trusted_transition_sha256",
        "trusted_workflow_git_blob_sha",
        "trusted_workflow_sha",
        "trusted_workflow_tree_sha"
      ],
      "properties": {
        "accepted_a8_sha": { "$ref": "#/$defs/sha1" },
        "acceptance_key": { "$ref": "#/$defs/sha256" },
        "artifact_id": { "type": "integer", "minimum": 1 },
        "artifact_name": { "type": "string", "pattern": "^phase8-engineering-witness-[1-9][0-9]*-[1-9][0-9]*$" },
        "artifact_subject_filename": { "const": "phase8-engineering-witness.tar" },
        "artifact_subject_sha256": { "$ref": "#/$defs/sha256" },
        "attestation_composite_sha256": { "$ref": "#/$defs/sha256" },
        "caller_workflow_file_sha256": { "$ref": "#/$defs/sha256" },
        "caller_workflow_git_blob_sha1": { "$ref": "#/$defs/sha1" },
        "candidate_changed_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_commit_sha": { "$ref": "#/$defs/sha1" },
        "candidate_diff_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_scope_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_sole_parent_sha": { "$ref": "#/$defs/sha1" },
        "candidate_tree_sha": { "$ref": "#/$defs/sha1" },
        "command_contract_git_blob_sha": { "$ref": "#/$defs/sha1" },
        "command_contract_payload_sha256": { "$ref": "#/$defs/sha256" },
        "command_contract_sha256": { "$ref": "#/$defs/sha256" },
        "command_artifact_set_sha256": { "$ref": "#/$defs/sha256" },
        "github_run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "github_run_id": { "type": "integer", "minimum": 1 },
        "repository": { "const": "Jupiter363/AfterSaleFlow-Agent" },
        "repository_id": { "const": "1282437633" },
        "signer_workflow": { "const": "Jupiter363/AfterSaleFlow-Agent/.github/workflows/phase8-engineering-witness.yml" },
        "source_ref": { "const": "refs/heads/codex/p8-production-hardening" },
        "trusted_code_blob_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "trusted_code_sha": { "$ref": "#/$defs/sha1" },
        "trusted_code_tree_sha": { "$ref": "#/$defs/sha1" },
        "trusted_transition_sha256": { "$ref": "#/$defs/sha256" },
        "trusted_workflow_git_blob_sha": { "$ref": "#/$defs/sha1" },
        "trusted_workflow_sha": { "$ref": "#/$defs/sha1" },
        "trusted_workflow_tree_sha": { "$ref": "#/$defs/sha1" }
      }
    },
    "reviewLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindings",
        "closed_finding_ids",
        "lane",
        "open_p0_count",
        "reviewed_at",
        "reviewed_topics",
        "reviewer_identity",
        "self_approved",
        "status"
      ],
      "properties": {
        "bindings": { "$ref": "#/$defs/laneBindings" },
        "closed_finding_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128,
            "pattern": "^P0-[A-Z0-9][A-Z0-9._-]*$"
          }
        },
        "lane": { "const": "consolidated" },
        "open_p0_count": { "const": 0 },
        "reviewed_at": { "type": "string", "format": "date-time", "maxLength": 64 },
        "reviewed_topics": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/topic" }
        },
        "reviewer_identity": { "$ref": "#/$defs/identity" },
        "self_approved": { "const": false },
        "status": { "const": "ALL_P0_CLOSED" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_ceiling",
        "capabilities",
        "cryptographic_production_attestation",
        "migrations",
        "production_reuse"
      ],
      "properties": {
        "authority_ceiling": { "const": "PHASE_8_ENGINEERING_CHECKPOINT_ONLY" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canary",
            "cloud_access",
            "database_access",
            "production_traffic",
            "promotion",
            "recovery_execution",
            "scheduler_off_activation",
            "secret_access",
            "temporal_access",
            "v046_production_apply",
            "v046_production_switch",
            "v047_cleanup"
          ],
          "properties": {
            "canary": { "const": false },
            "cloud_access": { "const": false },
            "database_access": { "const": false },
            "production_traffic": { "const": false },
            "promotion": { "const": false },
            "recovery_execution": { "const": false },
            "scheduler_off_activation": { "const": false },
            "secret_access": { "const": false },
            "temporal_access": { "const": false },
            "v046_production_apply": { "const": false },
            "v046_production_switch": { "const": false },
            "v047_cleanup": { "const": false }
          }
        },
        "cryptographic_production_attestation": { "const": false },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["MIG-006", "MIG-007", "MIG-008"],
          "properties": {
            "MIG-006": { "const": "PENDING_PROMOTION" },
            "MIG-007": { "const": "PENDING_PROMOTION" },
            "MIG-008": { "const": "PENDING_PROMOTION" }
          }
        },
        "production_reuse": { "const": "FORBIDDEN" }
      }
    },
    "selfSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "payload_sha256",
        "proves_execution_authenticity",
        "proves_production_authority"
      ],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "JSON_SORT_KEYS_COMPACT_UTF8_V1" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "proves_execution_authenticity": { "const": false },
        "proves_production_authority": { "const": false }
      }
    }
  }
}
