{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-execution-attempt-observation.schema.json", "title": "Outcome Ambiguous Execution Attempt Observation v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
  "required": ["schema_version", "workflow_id", "case_id", "observation_id", "observation_hash", "operation_id", "operation_key_hash", "request_hash", "external_idempotency_key_hash", "attempt_no", "operation_sequence", "required_for_closure", "compensable", "status", "external_effect_truth", "operation_status", "possible_dispatch_at", "observed_at", "epoch", "source_revision", "revision", "fence", "committed_event_sequence", "closure_blocked", "blind_retry_blocked", "compensation_blocked"],
  "properties": {
    "schema_version": {"const": "outcome-execution-attempt-observation.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "observation_id": {"$ref": "#/$defs/id"}, "observation_hash": {"$ref": "#/$defs/hash"}, "operation_id": {"$ref": "#/$defs/id"}, "operation_key_hash": {"$ref": "#/$defs/hash"}, "request_hash": {"$ref": "#/$defs/hash"}, "external_idempotency_key_hash": {"$ref": "#/$defs/hash"},
    "attempt_no": {"$ref": "#/$defs/positive"}, "operation_sequence": {"$ref": "#/$defs/operation_sequence"}, "required_for_closure": {"type": "boolean"}, "compensable": {"type": "boolean"}, "status": {"const": "AMBIGUOUS"}, "external_effect_truth": {"const": "UNKNOWN"}, "operation_status": {"const": "RECONCILING"}, "possible_dispatch_at": {"$ref": "#/$defs/timestamp"}, "observed_at": {"$ref": "#/$defs/timestamp"},
    "epoch": {"$ref": "#/$defs/positive"}, "source_revision": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "committed_event_sequence": {"$ref": "#/$defs/positive"}, "closure_blocked": {"const": true}, "blind_retry_blocked": {"const": true}, "compensation_blocked": {"const": true}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "operation_sequence": {"type": "integer", "minimum": 1, "maximum": 64}, "timestamp": {"type": "string", "format": "date-time"}}
}
