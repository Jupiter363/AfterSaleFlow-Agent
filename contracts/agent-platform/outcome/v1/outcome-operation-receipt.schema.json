{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-operation-receipt.schema.json", "title": "Outcome Authoritative Operation Receipt v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
  "required": ["schema_version", "workflow_id", "case_id", "receipt_id", "receipt_hash", "operation_id", "operation_key_hash", "request_hash", "external_idempotency_key_hash", "result_ref", "result_hash", "terminal_status", "operation_sequence", "required_for_closure", "compensable", "observed_at", "epoch", "source_revision", "revision", "fence", "committed_event_sequence", "runtime_mode", "synthetic_noop"],
  "properties": {
    "schema_version": {"const": "outcome-operation-receipt.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "receipt_id": {"$ref": "#/$defs/id"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "operation_id": {"$ref": "#/$defs/id"}, "operation_key_hash": {"$ref": "#/$defs/hash"}, "request_hash": {"$ref": "#/$defs/hash"}, "external_idempotency_key_hash": {"$ref": "#/$defs/hash"}, "result_ref": {"$ref": "#/$defs/ref"}, "result_hash": {"$ref": "#/$defs/hash"},
    "terminal_status": {"enum": ["SUCCEEDED", "FAILED"]}, "operation_sequence": {"$ref": "#/$defs/count"}, "required_for_closure": {"type": "boolean"}, "compensable": {"type": "boolean"}, "observed_at": {"$ref": "#/$defs/timestamp"},
    "epoch": {"$ref": "#/$defs/positive"}, "source_revision": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "committed_event_sequence": {"$ref": "#/$defs/count"}, "runtime_mode": {"const": "TEMPORAL"}, "synthetic_noop": {"const": false}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "timestamp": {"type": "string", "format": "date-time"}}
}
