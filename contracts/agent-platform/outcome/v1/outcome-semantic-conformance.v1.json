{
  "protocol_version": "outcome-semantic-conformance.v1",
  "raw_schema_only_validation": "NON_CONFORMANT",
  "validity_rule": "ALL_REQUIRED_STAGES_MUST_PASS",
  "validity_claim_without_all_stages": "FORBIDDEN",
  "unsupported_protocol_or_rule": "REJECT",
  "required_stages": ["DRAFT_2020_12_SCHEMA", "OUTCOME_SEMANTIC_RULES_V1"],
  "rules": [
    {
      "rule_id": "review-window-order.v1",
      "operator": "EPOCH_MILLI_REPRESENTABLE_INSTANT_STRICTLY_BEFORE",
      "left_field": "review_opened_at",
      "right_field": "review_deadline_at",
      "schema_files": ["outcome-workflow-start.schema.json"],
      "negative_fixtures": [
        {
          "schema_file": "outcome-workflow-start.schema.json",
          "fixture": "fixtures/invalid/outcome-workflow-start-invalid-review-window.json"
        }
      ]
    },
    {
      "rule_id": "causal-revision-adjacency.v1",
      "operator": "SAFE_INTEGER_SUCCESSOR",
      "left_field": "source_revision",
      "right_field": "revision",
      "schema_files": [
        "outcome-reviewer-decision-receipt.schema.json",
        "outcome-sla-escalation-receipt.schema.json",
        "outcome-operation-command.schema.json",
        "outcome-operation-receipt.schema.json",
        "outcome-execution-attempt-observation.schema.json",
        "outcome-attempt-reconciliation-receipt.schema.json",
        "outcome-compensation-receipt.schema.json",
        "outcome-closure-receipt.schema.json",
        "outcome-evaluation-receipt.schema.json"
      ],
      "negative_fixtures": [
        {
          "schema_file": "outcome-reviewer-decision-receipt.schema.json",
          "fixture": "fixtures/invalid/outcome-reviewer-decision-revision-gap.json"
        }
      ]
    },
    {
      "rule_id": "terminal-success-count-equality.v1",
      "operator": "SAFE_INTEGER_EQUALS",
      "left_field": "terminal_success_receipt_count",
      "right_field": "required_operation_count",
      "condition": {
        "field": "phase",
        "operator": "IN",
        "values": ["CLOSED", "EVALUATED"]
      },
      "schema_files": ["outcome-process-projection.schema.json"],
      "negative_fixtures": [
        {
          "schema_file": "outcome-process-projection.schema.json",
          "fixture": "fixtures/invalid/outcome-process-projection-closed-success-count-mismatch.json"
        }
      ]
    },
    {
      "rule_id": "compensation-receipt-id-equality.v1",
      "operator": "TEXT_EQUALS",
      "left_field": "receipt_id",
      "right_field": "compensation_receipt_id",
      "schema_files": ["outcome-compensation-receipt.schema.json"],
      "negative_fixtures": [
        {
          "schema_file": "outcome-compensation-receipt.schema.json",
          "fixture": "fixtures/invalid/outcome-compensation-receipt-id-mismatch.json"
        }
      ]
    },
    {
      "rule_id": "compensation-receipt-hash-equality.v1",
      "operator": "TEXT_EQUALS",
      "left_field": "receipt_hash",
      "right_field": "compensation_receipt_hash",
      "schema_files": ["outcome-compensation-receipt.schema.json"],
      "negative_fixtures": [
        {
          "schema_file": "outcome-compensation-receipt.schema.json",
          "fixture": "fixtures/invalid/outcome-compensation-receipt-hash-mismatch.json"
        }
      ]
    }
  ]
}
