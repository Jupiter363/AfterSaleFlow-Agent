{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-sla-escalation-receipt.schema.json",
  "title": "Outcome System SLA Escalation Receipt v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
  "required": ["schema_version", "workflow_id", "case_id", "receipt_id", "receipt_hash", "review_task_id", "frozen_review_packet_ref", "frozen_review_packet_hash", "fact_type", "actor", "deadline_at", "committed_at", "epoch", "source_revision", "revision", "fence", "committed_event_sequence", "execution_authorized", "approval_record_created", "synthetic_only"],
  "properties": {
    "schema_version": {"const": "outcome-sla-escalation-receipt.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "receipt_id": {"$ref": "#/$defs/id"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "review_task_id": {"$ref": "#/$defs/id"},
    "frozen_review_packet_ref": {"$ref": "#/$defs/ref"}, "frozen_review_packet_hash": {"$ref": "#/$defs/hash"}, "fact_type": {"const": "SYSTEM_SLA_ESCALATION"}, "actor": {"const": "SYSTEM"},
    "deadline_at": {"$ref": "#/$defs/timestamp"}, "committed_at": {"$ref": "#/$defs/timestamp"}, "epoch": {"$ref": "#/$defs/positive"}, "source_revision": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "committed_event_sequence": {"$ref": "#/$defs/positive"},
    "execution_authorized": {"const": false}, "approval_record_created": {"const": false}, "synthetic_only": {"type": "boolean"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "timestamp": {"type": "string", "format": "date-time"}}
}
