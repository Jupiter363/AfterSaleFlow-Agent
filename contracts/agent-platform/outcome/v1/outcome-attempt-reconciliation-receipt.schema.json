{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-attempt-reconciliation-receipt.schema.json", "title": "Outcome Attempt Reconciliation Receipt v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
  "x-semantic-conformance": {"protocol_version": "outcome-semantic-conformance.v1", "manifest": "outcome-semantic-conformance.v1.json", "raw_schema_only_validation": "NON_CONFORMANT", "required_rules": ["causal-revision-adjacency.v1"]},
  "required": ["schema_version", "workflow_id", "case_id", "receipt_id", "receipt_hash", "observation_id", "observation_hash", "operation_id", "operation_key_hash", "request_hash", "external_idempotency_key_hash", "operation_sequence", "required_for_closure", "compensable", "resolution", "retry_allowed", "manual_recovery_required", "reconciled_at", "epoch", "source_revision", "revision", "fence", "committed_event_sequence"],
  "properties": {
    "schema_version": {"const": "outcome-attempt-reconciliation-receipt.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "receipt_id": {"$ref": "#/$defs/id"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "observation_id": {"$ref": "#/$defs/id"}, "observation_hash": {"$ref": "#/$defs/hash"}, "operation_id": {"$ref": "#/$defs/id"}, "operation_key_hash": {"$ref": "#/$defs/hash"}, "request_hash": {"$ref": "#/$defs/hash"}, "external_idempotency_key_hash": {"$ref": "#/$defs/hash"},
    "operation_sequence": {"$ref": "#/$defs/operation_sequence"}, "required_for_closure": {"type": "boolean"}, "compensable": {"type": "boolean"}, "resolution": {"enum": ["CONFIRMED_SUCCESS", "CONFIRMED_FAILURE", "NOT_FOUND_SAFE_TO_RETRY", "UNRESOLVED"]}, "authoritative_receipt_ref": {"$ref": "#/$defs/ref"}, "authoritative_receipt_hash": {"$ref": "#/$defs/hash"}, "retry_allowed": {"type": "boolean"}, "manual_recovery_required": {"type": "boolean"}, "reconciled_at": {"$ref": "#/$defs/timestamp"},
    "epoch": {"$ref": "#/$defs/count"}, "source_revision": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "committed_event_sequence": {"$ref": "#/$defs/positive"}
  },
  "allOf": [
    {"if": {"properties": {"resolution": {"enum": ["CONFIRMED_SUCCESS", "CONFIRMED_FAILURE"]}}}, "then": {"required": ["authoritative_receipt_ref", "authoritative_receipt_hash"]}, "else": {"not": {"anyOf": [{"required": ["authoritative_receipt_ref"]}, {"required": ["authoritative_receipt_hash"]}]}}},
    {"if": {"properties": {"resolution": {"const": "NOT_FOUND_SAFE_TO_RETRY"}}}, "then": {"properties": {"retry_allowed": {"const": true}}}, "else": {"properties": {"retry_allowed": {"const": false}}}},
    {"if": {"properties": {"resolution": {"const": "UNRESOLVED"}}}, "then": {"properties": {"manual_recovery_required": {"const": true}}}, "else": {"properties": {"manual_recovery_required": {"const": false}}}}
  ],
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "operation_sequence": {"type": "integer", "minimum": 1, "maximum": 64}, "timestamp": {"type": "string", "format": "date-time"}}
}
