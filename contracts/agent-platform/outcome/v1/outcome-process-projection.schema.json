{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-process-projection.schema.json", "title": "Outcome Process Projection v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
  "x-semantic-conformance": {"protocol_version": "outcome-semantic-conformance.v1", "manifest": "outcome-semantic-conformance.v1.json", "raw_schema_only_validation": "NON_CONFORMANT", "required_rules": ["terminal-success-count-equality.v1"]},
  "required": ["schema_version", "workflow_id", "case_id", "phase", "required_operation_set_ref", "required_operation_set_hash", "required_operation_count", "terminal_success_receipt_count", "unresolved_ambiguous_count", "failed_required_receipt_count", "in_flight_operation_count", "in_flight_compensation_count", "unresolved_manual_recovery_count", "epoch", "revision", "fence", "writer_mode", "runtime_mode", "projection_only"],
  "properties": {
    "schema_version": {"const": "outcome-process-projection.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "phase": {"enum": ["WAITING_REVIEW", "DECISION_COMMITTED", "SLA_ESCALATED", "EXECUTING", "RECONCILING", "COMPENSATING", "CLOSURE_PENDING", "CLOSED", "EVALUATED", "MANUAL_RECOVERY"]},
    "terminal_review_receipt_ref": {"$ref": "#/$defs/ref"}, "terminal_review_receipt_hash": {"$ref": "#/$defs/hash"}, "required_operation_set_ref": {"$ref": "#/$defs/ref"}, "required_operation_set_hash": {"$ref": "#/$defs/hash"}, "required_operation_count": {"$ref": "#/$defs/count"}, "terminal_success_receipt_count": {"$ref": "#/$defs/count"}, "unresolved_ambiguous_count": {"$ref": "#/$defs/count"}, "failed_required_receipt_count": {"$ref": "#/$defs/count"}, "in_flight_operation_count": {"$ref": "#/$defs/count"}, "in_flight_compensation_count": {"$ref": "#/$defs/count"}, "unresolved_manual_recovery_count": {"$ref": "#/$defs/count"},
    "closure_receipt_ref": {"$ref": "#/$defs/ref"}, "closure_receipt_hash": {"$ref": "#/$defs/hash"}, "evaluation_receipt_ref": {"$ref": "#/$defs/ref"}, "evaluation_receipt_hash": {"$ref": "#/$defs/hash"}, "epoch": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "writer_mode": {"enum": ["LEGACY", "SHADOW", "TEMPORAL"]}, "runtime_mode": {"enum": ["DISABLED", "JAVA_SIGNED_SYNTHETIC_NOOP_SHADOW", "TEMPORAL"]}, "synthetic_noop_marker": {"const": "JAVA_SIGNED_SYNTHETIC_NOOP_V1"}, "projection_only": {"type": "boolean"}
  },
