    "evaluation_receipt_ref": ["evaluation_receipt_hash"],
    "evaluation_receipt_hash": ["evaluation_receipt_ref"]
  },
  "allOf": [
    {"if": {"properties": {"runtime_mode": {"const": "JAVA_SIGNED_SYNTHETIC_NOOP_SHADOW"}}}, "then": {"required": ["synthetic_noop_marker"], "properties": {"writer_mode": {"const": "SHADOW"}, "projection_only": {"const": true}, "phase": {"not": {"enum": ["CLOSED", "EVALUATED"]}}}, "not": {"anyOf": [{"required": ["closure_receipt_ref"]}, {"required": ["closure_receipt_hash"]}, {"required": ["evaluation_receipt_ref"]}, {"required": ["evaluation_receipt_hash"]}]}}, "else": {"not": {"required": ["synthetic_noop_marker"]}, "properties": {"projection_only": {"const": false}}}},
    {"if": {"properties": {"phase": {"enum": ["CLOSED", "EVALUATED"]}}}, "then": {"required": ["closure_receipt_ref", "closure_receipt_hash"], "properties": {"unresolved_ambiguous_count": {"const": 0}, "failed_required_receipt_count": {"const": 0}, "in_flight_operation_count": {"const": 0}, "in_flight_compensation_count": {"const": 0}, "unresolved_manual_recovery_count": {"const": 0}}}},
    {"if": {"properties": {"phase": {"const": "EVALUATED"}}}, "then": {"required": ["evaluation_receipt_ref", "evaluation_receipt_hash"]}}
  ],
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
