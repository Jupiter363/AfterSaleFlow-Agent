{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-closure-receipt.schema.json", "title": "Outcome Closure Receipt v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
  "x-semantic-conformance": {"protocol_version": "outcome-semantic-conformance.v1", "manifest": "outcome-semantic-conformance.v1.json", "raw_schema_only_validation": "NON_CONFORMANT", "required_rules": ["causal-revision-adjacency.v1"]},
  "required": ["schema_version", "workflow_id", "case_id", "receipt_id", "receipt_hash", "approval_receipt_ref", "approval_receipt_hash", "approved_action_snapshot_ref", "approved_action_snapshot_hash", "required_operation_set_ref", "required_operation_set_hash", "required_operation_count", "terminal_receipt_set_ref", "terminal_receipt_set_hash", "closed_snapshot_ref", "closed_snapshot_hash", "final_case_revision", "unresolved_ambiguous_count", "failed_required_receipt_count", "in_flight_operation_count", "in_flight_compensation_count", "unresolved_manual_recovery_count", "closed_at", "epoch", "source_revision", "revision", "fence", "committed_event_sequence", "synthetic_noop"],
  "properties": {
    "schema_version": {"const": "outcome-closure-receipt.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "receipt_id": {"$ref": "#/$defs/id"}, "receipt_hash": {"$ref": "#/$defs/hash"}, "approval_receipt_ref": {"$ref": "#/$defs/ref"}, "approval_receipt_hash": {"$ref": "#/$defs/hash"}, "approved_action_snapshot_ref": {"$ref": "#/$defs/ref"}, "approved_action_snapshot_hash": {"$ref": "#/$defs/hash"}, "required_operation_set_ref": {"$ref": "#/$defs/ref"}, "required_operation_set_hash": {"$ref": "#/$defs/hash"}, "required_operation_count": {"$ref": "#/$defs/count"}, "terminal_receipt_set_ref": {"$ref": "#/$defs/ref"}, "terminal_receipt_set_hash": {"$ref": "#/$defs/hash"}, "closed_snapshot_ref": {"$ref": "#/$defs/ref"}, "closed_snapshot_hash": {"$ref": "#/$defs/hash"}, "final_case_revision": {"$ref": "#/$defs/count"},
    "unresolved_ambiguous_count": {"const": 0}, "failed_required_receipt_count": {"const": 0}, "in_flight_operation_count": {"const": 0}, "in_flight_compensation_count": {"const": 0}, "unresolved_manual_recovery_count": {"const": 0}, "closed_at": {"$ref": "#/$defs/timestamp"}, "epoch": {"$ref": "#/$defs/positive"}, "source_revision": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "committed_event_sequence": {"$ref": "#/$defs/positive"}, "synthetic_noop": {"const": false}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "timestamp": {"type": "string", "format": "date-time"}}
}
