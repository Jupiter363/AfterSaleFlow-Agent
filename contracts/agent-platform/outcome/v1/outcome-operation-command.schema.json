{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.after-sale-flow.example/agent-platform/outcome/v1/outcome-operation-command.schema.json", "title": "Outcome Operation Command v1",
  "type": "object", "additionalProperties": false, "x-max-encoded-bytes": 32768,
