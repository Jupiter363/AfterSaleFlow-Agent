  "required": ["schema_version", "workflow_id", "case_id", "command_id", "operation_id", "operation_key_hash", "approval_receipt_ref", "approval_receipt_hash", "approved_action_snapshot_ref", "approved_action_snapshot_hash", "request_ref", "request_hash", "external_idempotency_key_hash", "effect_class", "required_for_closure", "compensable", "operation_sequence", "epoch", "source_revision", "revision", "fence", "committed_event_sequence", "attempt_no", "deadline_at", "tool_capability_version", "runtime_mode", "synthetic_only"],
  "properties": {
    "schema_version": {"const": "outcome-operation-command.v1"}, "workflow_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "command_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"}, "operation_key_hash": {"$ref": "#/$defs/hash"},
    "approval_receipt_ref": {"$ref": "#/$defs/ref"}, "approval_receipt_hash": {"$ref": "#/$defs/hash"}, "approved_action_snapshot_ref": {"$ref": "#/$defs/ref"}, "approved_action_snapshot_hash": {"$ref": "#/$defs/hash"}, "request_ref": {"$ref": "#/$defs/ref"}, "request_hash": {"$ref": "#/$defs/hash"}, "external_idempotency_key_hash": {"$ref": "#/$defs/hash"},
    "effect_class": {"enum": ["NO_EXTERNAL_EFFECT", "REVERSIBLE", "IRREVERSIBLE"]}, "required_for_closure": {"type": "boolean"}, "compensable": {"type": "boolean"}, "operation_sequence": {"$ref": "#/$defs/operation_sequence"},
    "epoch": {"$ref": "#/$defs/positive"}, "source_revision": {"$ref": "#/$defs/count"}, "revision": {"$ref": "#/$defs/count"}, "fence": {"$ref": "#/$defs/positive"}, "committed_event_sequence": {"$ref": "#/$defs/positive"}, "attempt_no": {"$ref": "#/$defs/positive"}, "deadline_at": {"$ref": "#/$defs/timestamp"}, "tool_capability_version": {"$ref": "#/$defs/id"},
    "runtime_mode": {"enum": ["JAVA_SIGNED_SYNTHETIC_NOOP_SHADOW", "TEMPORAL"]}, "synthetic_noop_marker": {"const": "JAVA_SIGNED_SYNTHETIC_NOOP_V1"}, "synthetic_only": {"type": "boolean"}
  },
  "allOf": [{"if": {"properties": {"runtime_mode": {"const": "JAVA_SIGNED_SYNTHETIC_NOOP_SHADOW"}}}, "then": {"required": ["synthetic_noop_marker"], "properties": {"synthetic_only": {"const": true}, "effect_class": {"const": "NO_EXTERNAL_EFFECT"}, "compensable": {"const": false}}}, "else": {"properties": {"synthetic_only": {"const": false}}, "not": {"required": ["synthetic_noop_marker"]}}}],
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "ref": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "operation_sequence": {"type": "integer", "minimum": 1, "maximum": 64}, "timestamp": {"type": "string", "format": "date-time"}}
