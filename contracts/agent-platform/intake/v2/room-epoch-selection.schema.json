{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/intake/v2/room-epoch-selection.schema.json",
  "title": "Room Epoch Selection v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "room_type", "writer_mode", "case_workflow_type",
    "case_workflow_build_id", "room_workflow_type", "room_workflow_build_id",
    "process_contract_version", "graph_key", "graph_version", "checkpoint_schema_version",
    "state_schema_version", "stream_protocol", "prompt_version", "model_profile_id",
    "output_schema_version", "policy_version", "guardrail_version", "tool_policy_version",
    "cohort_policy_version", "selection_hash"
  ],
  "properties": {
    "schema_version": {"const": "room-epoch-selection.v2"},
    "room_type": {"enum": ["INTAKE", "EVIDENCE", "HEARING", "REVIEW"]},
    "writer_mode": {"enum": ["LEGACY", "SHADOW", "TEMPORAL"]},
    "case_workflow_type": {"const": "CaseProcessWorkflow"},
    "case_workflow_build_id": {"$ref": "#/$defs/identifier"},
    "room_workflow_type": {"$ref": "#/$defs/identifier"},
    "room_workflow_build_id": {"$ref": "#/$defs/identifier"},
    "process_contract_version": {"$ref": "#/$defs/identifier"},
    "graph_key": {"$ref": "#/$defs/identifier"},
    "graph_version": {"$ref": "#/$defs/identifier"},
    "checkpoint_schema_version": {"$ref": "#/$defs/identifier"},
    "state_schema_version": {"$ref": "#/$defs/identifier"},
    "stream_protocol": {"$ref": "#/$defs/identifier"},
    "prompt_version": {"$ref": "#/$defs/identifier"},
    "model_profile_id": {"$ref": "#/$defs/identifier"},
    "output_schema_version": {"$ref": "#/$defs/identifier"},
    "policy_version": {"$ref": "#/$defs/identifier"},
    "guardrail_version": {"$ref": "#/$defs/identifier"},
    "tool_policy_version": {"$ref": "#/$defs/identifier"},
    "cohort_policy_version": {"$ref": "#/$defs/identifier"},
    "selection_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"room_type": {"const": "INTAKE"}}},
      "then": {
        "properties": {
          "graph_key": {"const": "intake.v2"}
        }
      },
      "else": {
        "properties": {
          "writer_mode": {"const": "LEGACY"}
        }
      }
    },
    {
      "if": {"properties": {"writer_mode": {"enum": ["SHADOW", "TEMPORAL"]}}},
      "then": {
        "properties": {
          "room_type": {"const": "INTAKE"},
          "room_workflow_type": {"const": "IntakeRoomWorkflow"},
          "state_schema_version": {"const": "intake-graph-state.v2"},
          "output_schema_version": {"const": "intake-turn-proposal.v2"}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
