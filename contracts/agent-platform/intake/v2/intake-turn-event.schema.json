{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/intake/v2/intake-turn-event.schema.json",
  "title": "Intake Turn Event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "message_id", "tenant_surrogate", "case_id",
    "room_type", "room_epoch", "thread_id", "actor_scope_hash", "agent_session_id",
    "sequence_no", "domain_revision", "audience", "source_type", "text", "source_refs",
    "occurred_at", "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "intake-turn-event.v2"},
    "event_id": {"$ref": "#/$defs/identifier"},
    "message_id": {"$ref": "#/$defs/identifier"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_type": {"const": "INTAKE"},
    "room_epoch": {"type": "integer", "minimum": 0},
    "thread_id": {"$ref": "#/$defs/thread_id"},
    "actor_scope_hash": {"$ref": "#/$defs/sha256"},
    "agent_session_id": {"$ref": "#/$defs/identifier"},
    "sequence_no": {"type": "integer", "minimum": 1},
    "domain_revision": {"type": "integer", "minimum": 0},
    "audience": {"enum": ["USER", "MERCHANT"]},
    "source_type": {"enum": ["INITIAL_FORM", "ROOM_MESSAGE", "FORMAL_EVENT"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "source_refs": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thread_id": {"type": "string", "pattern": "^grt\\.v1\\.[0-9a-f]{32}$"}
  }
}
