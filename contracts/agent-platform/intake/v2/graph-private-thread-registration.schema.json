{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/intake/v2/graph-private-thread-registration.schema.json",
  "title": "Graph Private Thread Registration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "registration_id", "tenant_surrogate", "case_id", "room_type",
    "room_epoch", "thread_id", "actor_scope", "actor_scope_hash", "agent_session_id",
    "graph_key", "graph_version", "checkpoint_schema_version", "state_schema_version",
    "prompt_version", "model_profile_id", "output_schema_version", "policy_version",
    "guardrail_version", "tool_policy_version", "writer_mode", "issued_at",
    "registration_hash"
  ],
  "properties": {
    "schema_version": {"const": "graph-private-thread-registration.v1"},
    "registration_id": {"$ref": "#/$defs/identifier"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_type": {"const": "INTAKE"},
    "room_epoch": {"type": "integer", "minimum": 0},
    "thread_id": {"$ref": "#/$defs/thread_id"},
    "actor_scope": {"$ref": "#/$defs/actor_scope"},
    "actor_scope_hash": {"$ref": "#/$defs/sha256"},
    "agent_session_id": {"$ref": "#/$defs/identifier"},
    "graph_key": {"const": "intake.v2"},
    "graph_version": {"$ref": "#/$defs/identifier"},
    "checkpoint_schema_version": {"$ref": "#/$defs/identifier"},
    "state_schema_version": {"const": "intake-graph-state.v2"},
    "prompt_version": {"$ref": "#/$defs/identifier"},
    "model_profile_id": {"$ref": "#/$defs/identifier"},
    "output_schema_version": {"const": "intake-turn-proposal.v2"},
    "policy_version": {"$ref": "#/$defs/identifier"},
    "guardrail_version": {"$ref": "#/$defs/identifier"},
    "tool_policy_version": {"$ref": "#/$defs/identifier"},
    "writer_mode": {"enum": ["SHADOW", "TEMPORAL"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "registration_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thread_id": {"type": "string", "pattern": "^grt\\.v1\\.[0-9a-f]{32}$"},
    "actor_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_role", "audience", "capabilities"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/identifier"},
        "actor_role": {"enum": ["USER", "MERCHANT"]},
        "audience": {"enum": ["USER", "MERCHANT"]},
        "capabilities": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"actor_role": {"const": "USER"}}},
          "then": {"properties": {"audience": {"const": "USER"}}}
        },
        {
          "if": {"properties": {"actor_role": {"const": "MERCHANT"}}},
          "then": {"properties": {"audience": {"const": "MERCHANT"}}}
        }
      ]
    }
  }
}
