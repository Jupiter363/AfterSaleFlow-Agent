{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/intake/v2/intake-finalization-receipt.schema.json",
  "title": "Intake Finalization Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_key", "tenant_surrogate", "case_id", "room_epoch",
    "thread_id", "actor_scope_hash", "agent_session_id", "command_id", "logical_run_id",
    "attempt_id", "result_hash", "proposal_hash", "process_revision", "room_revision",
    "fencing_token", "formal_message_id", "domain_event_ids", "outbox_ids", "status",
    "committed_at", "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "intake-finalization-receipt.v1"},
    "operation_key": {"$ref": "#/$defs/operation_key"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_epoch": {"type": "integer", "minimum": 0},
    "thread_id": {"$ref": "#/$defs/thread_id"},
    "actor_scope_hash": {"$ref": "#/$defs/sha256"},
    "agent_session_id": {"$ref": "#/$defs/identifier"},
    "command_id": {"$ref": "#/$defs/identifier"},
    "logical_run_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "result_hash": {"$ref": "#/$defs/sha256"},
    "proposal_hash": {"$ref": "#/$defs/sha256"},
    "process_revision": {"type": "integer", "minimum": 0},
    "room_revision": {"type": "integer", "minimum": 0},
    "fencing_token": {"type": "integer", "minimum": 1},
    "formal_message_id": {"$ref": "#/$defs/identifier"},
    "dossier_version": {"type": "integer", "minimum": 1},
    "matrix_version": {"type": "integer", "minimum": 1},
    "domain_event_ids": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "outbox_ids": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "status": {"const": "COMMITTED"},
    "committed_at": {"type": "string", "format": "date-time"},
    "receipt_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "operation_key": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,511}$"
    },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thread_id": {"type": "string", "pattern": "^grt\\.v1\\.[0-9a-f]{32}$"}
  }
}
