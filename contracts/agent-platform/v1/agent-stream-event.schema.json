{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/v1/agent-stream-event.schema.json",
  "title": "AgentStreamEvent v2",
  "description": "Durable public stream event scoped to one logical run attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "sequence_no",
    "event_type",
    "audience",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "agent-stream.v2"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "sequence_no": {"type": "integer", "minimum": 0},
    "event_type": {
      "type": "string",
      "enum": [
        "attempt_started",
        "visible_delta",
        "usage",
        "attempt_aborted",
        "attempt_reset",
        "final",
        "error"
      ]
    },
    "audience": {
      "type": "string",
      "enum": ["USER", "MERCHANT", "PLATFORM_REVIEWER", "SYSTEM"]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "oneOf": [
    {"properties": {"event_type": {"const": "attempt_started"}, "payload": {"required": ["node"]}}},
    {"properties": {"event_type": {"const": "visible_delta"}, "payload": {"required": ["node", "field", "delta"]}}},
    {"properties": {"event_type": {"const": "usage"}, "payload": {"required": ["usage"]}}},
    {"properties": {"event_type": {"const": "attempt_aborted"}, "payload": {"required": ["reason_code"]}}},
    {"properties": {"event_type": {"const": "attempt_reset"}, "payload": {"required": ["reset_attempt_id", "reason_code"]}}},
    {"properties": {"event_type": {"const": "final"}, "payload": {"required": ["final_result_ref", "final_result_hash"]}}},
    {"properties": {"event_type": {"const": "error"}, "payload": {"required": ["error_code", "retryable"]}}}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {"$ref": "#/$defs/identifier"},
        "field": {"$ref": "#/$defs/identifier"},
        "delta": {"type": "string", "minLength": 1, "maxLength": 4096},
        "usage": {"$ref": "#/$defs/usage"},
        "reason_code": {"$ref": "#/$defs/identifier"},
        "reset_attempt_id": {"$ref": "#/$defs/identifier"},
        "final_result_ref": {"type": "string", "format": "uri", "pattern": "^(s3|minio|urn):", "maxLength": 1024},
        "final_result_hash": {"$ref": "#/$defs/sha256"},
        "error_code": {"$ref": "#/$defs/identifier"},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
