{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/v1/room-graph-command.schema.json",
  "title": "RoomGraphCommand v1",
  "description": "Signed, version-pinned cognitive command sent from a Java Agent Activity to Python.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "logical_run_id",
    "attempt_id",
    "tenant_surrogate",
    "case_id",
    "room_type",
    "room_epoch",
    "graph_key",
    "graph_version",
    "checkpoint_schema_version",
    "thread_id",
    "actor_scope",
    "process_revision",
    "stage_code",
    "stage_sequence",
    "domain_snapshot_ref",
    "invocation_context",
    "retry_budget",
    "deadline_at",
    "traceparent",
    "request_hash"
  ],
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "invocation_context": {
                "properties": {
                  "agent_profile_id": {
                    "const": "dispute-intake-officer.parallel-frames.v1"
                  }
                }
              }
            }
          },
          {"required": ["room_id"]}
        ]
      },
      "then": {
        "required": ["room_id", "event_ref"],
        "properties": {
          "room_type": {"const": "INTAKE"},
          "actor_scope": {
            "oneOf": [
              {
                "properties": {
                  "actor_role": {"const": "USER"},
                  "audience": {"const": "USER"}
                }
              },
              {
                "properties": {
                  "actor_role": {"const": "MERCHANT"},
                  "audience": {"const": "MERCHANT"}
                }
              }
            ]
          },
          "invocation_context": {
            "properties": {
              "agent_profile_id": {
                "const": "dispute-intake-officer.parallel-frames.v1"
              },
              "output_schema_version": {
                "const": "production-runtime-room-proposal-source.v2"
              }
            }
          },
          "retry_budget": {
            "properties": {
              "provider_attempts_remaining": {"minimum": 3, "maximum": 6}
            }
          }
        }
      },
      "else": {
        "properties": {"room_id": false},
        "allOf": [
          {
            "if": {
              "properties": {
                "retry_budget": {
                  "properties": {
                    "provider_attempts_remaining": {"minimum": 3}
                  }
                }
              }
            },
            "then": {
              "properties": {
                "room_type": {"const": "HEARING"},
                "stage_code": {"const": "EVIDENCE_SYNTHESIZING"}
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "room-graph-command.v1"},
    "command_id": {"$ref": "#/$defs/identifier"},
    "logical_run_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_id": {"$ref": "#/$defs/identifier"},
    "room_type": {"type": "string", "enum": ["INTAKE", "EVIDENCE", "HEARING", "REVIEW"]},
    "room_epoch": {"type": "integer", "minimum": 0},
    "graph_key": {"$ref": "#/$defs/identifier"},
    "graph_version": {"$ref": "#/$defs/identifier"},
    "checkpoint_schema_version": {"$ref": "#/$defs/identifier"},
    "thread_id": {"$ref": "#/$defs/graph_thread_id"},
    "actor_scope": {"$ref": "#/$defs/actor_scope"},
    "process_revision": {"type": "integer", "minimum": 0},
    "stage_code": {"$ref": "#/$defs/identifier"},
    "stage_sequence": {"type": "integer", "minimum": 0},
    "domain_snapshot_ref": {"$ref": "#/$defs/snapshot_ref"},
    "event_ref": {"$ref": "#/$defs/snapshot_ref"},
    "invocation_context": {"$ref": "#/$defs/invocation_context"},
    "retry_budget": {"$ref": "#/$defs/retry_budget"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "traceparent": {"$ref": "#/$defs/traceparent"},
    "request_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "graph_thread_id": {
      "type": "string",
      "pattern": "^grt\\.v1\\.[0-9a-f]{32}$"
    },
    "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},
    "actor_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_role", "audience", "capabilities"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/identifier"},
        "actor_role": {
          "type": "string",
          "enum": ["USER", "MERCHANT", "PLATFORM_REVIEWER", "ADMIN", "SYSTEM"]
        },
        "audience": {
          "type": "string",
          "enum": ["USER", "MERCHANT", "PLATFORM_REVIEWER", "SYSTEM"]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "schema_version", "uri", "sha256", "size_bytes"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "schema_version": {"$ref": "#/$defs/identifier"},
        "uri": {"type": "string", "format": "uri", "pattern": "^(s3|minio|urn):", "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}
      }
    },
    "invocation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_profile_id",
        "prompt_profile_id",
        "model_profile_id",
        "output_schema_version",
        "policy_version",
        "guardrail_version",
        "tool_capabilities",
        "envelope_key_id",
        "envelope_nonce"
      ],
      "properties": {
        "agent_profile_id": {"$ref": "#/$defs/identifier"},
        "prompt_profile_id": {"$ref": "#/$defs/identifier"},
        "model_profile_id": {"$ref": "#/$defs/identifier"},
        "output_schema_version": {"$ref": "#/$defs/identifier"},
        "policy_version": {"$ref": "#/$defs/identifier"},
        "guardrail_version": {"$ref": "#/$defs/identifier"},
        "tool_capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "envelope_key_id": {"$ref": "#/$defs/identifier"},
        "envelope_nonce": {"$ref": "#/$defs/identifier"}
      }
    },
    "retry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_attempts_remaining", "activity_attempts_remaining", "repairs_remaining"],
      "properties": {
        "provider_attempts_remaining": {"type": "integer", "minimum": 0, "maximum": 202},
        "activity_attempts_remaining": {"type": "integer", "minimum": 0, "maximum": 3},
        "repairs_remaining": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
