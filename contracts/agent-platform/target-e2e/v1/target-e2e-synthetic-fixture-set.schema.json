{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/target-e2e/v1/target-e2e-synthetic-fixture-set.schema.json",
  "title": "Target E2E Canonical Synthetic Fixture Set v1",
  "type": "object",
  "additionalProperties": false,
  "x-canonical-hash": {"algorithm": "SHA-256", "preimage": "RFC8785_FULL_VALIDATED_DOCUMENT", "consumerField": "activation.caseScope.fixtureSetHash"},
  "required": ["schemaVersion", "fixtureSetId", "caseIdPrefix", "maximumCases", "roomTypes", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "target-e2e-synthetic-fixture-set.v1"},
    "fixtureSetId": {"$ref": "#/$defs/identifier"},
    "caseIdPrefix": {"type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Z][A-Z0-9_]{2,31}$"},
    "maximumCases": {"type": "integer", "minimum": 1, "maximum": 16},
    "roomTypes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["INTAKE", "EVIDENCE", "HEARING", "REVIEW"]}
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "roomType", "inputSchemaVersion", "inputHash", "expectedTerminalClass"],
      "properties": {
        "fixtureId": {"$ref": "#/$defs/identifier"},
        "roomType": {"enum": ["INTAKE", "EVIDENCE", "HEARING", "REVIEW"]},
        "inputSchemaVersion": {"$ref": "#/$defs/identifier"},
        "inputHash": {"$ref": "#/$defs/sha256"},
        "expectedTerminalClass": {"enum": ["NEEDS_INPUT", "COMPLETED", "NEEDS_REVIEW"]}
      }
    }
  }
}
