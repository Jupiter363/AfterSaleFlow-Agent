{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.after-sale-flow.example/agent-platform/target-e2e/v1/target-e2e-finalization-receipt.schema.json",
  "title": "Target E2E Java Finalization Receipt v1",
  "description": "Java-authored receipt binding a formal Domain commit to one target-E2E activation and Graph proposal.",
  "type": "object",
  "additionalProperties": false,
  "x-canonicalization": "RFC_8785",
  "x-self-hash": {"algorithm": "SHA-256", "field": "receipt_hash", "preimage": "RFC8785_OMIT_TOP_LEVEL_FIELD", "omitFields": ["receipt_hash"]},
  "required": [
    "schema_version",
    "execution_lane",
    "activation_id",
    "tenant_surrogate",
    "case_id",
    "room_type",
    "room_epoch",
    "fencing_token",
    "process_revision",
    "stage_sequence",
    "logical_run_id",
    "attempt_id",
    "command_hash",
    "command_envelope_hash",
    "graph_key",
    "graph_version",
    "checkpoint_schema_version",
    "checkpoint_id",
    "result_hash",
    "proposal_hash",
    "result_envelope_hash",
    "agent_run_manifest_id",
    "agent_run_manifest_hash",
    "isolated_domain_db_binding_hash",
    "committed_at",
    "receipt_hash",
    "formal_writer",
    "domain_commit_status"
  ],
  "properties": {
    "schema_version": {"const": "target-e2e-finalization-receipt.v1"},
    "execution_lane": {"const": "TARGET_E2E_CANDIDATE"},
    "activation_id": {"type": "string", "pattern": "^p9act\\.v1\\.[0-9a-f]{32}$"},
    "tenant_surrogate": {"$ref": "#/$defs/identifier"},
    "case_id": {"$ref": "#/$defs/identifier"},
    "room_type": {"enum": ["INTAKE", "EVIDENCE", "HEARING", "REVIEW"]},
    "room_epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "process_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "stage_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "logical_run_id": {"$ref": "#/$defs/identifier"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "command_hash": {"$ref": "#/$defs/sha256"},
    "command_envelope_hash": {"$ref": "#/$defs/sha256"},
    "graph_key": {"$ref": "#/$defs/identifier"},
    "graph_version": {"$ref": "#/$defs/identifier"},
    "checkpoint_schema_version": {"$ref": "#/$defs/identifier"},
    "checkpoint_id": {"$ref": "#/$defs/identifier"},
    "result_hash": {"$ref": "#/$defs/sha256"},
    "proposal_hash": {"$ref": "#/$defs/sha256"},
    "result_envelope_hash": {"$ref": "#/$defs/sha256"},
    "agent_run_manifest_id": {"$ref": "#/$defs/identifier"},
    "agent_run_manifest_hash": {"$ref": "#/$defs/sha256"},
    "isolated_domain_db_binding_hash": {"$ref": "#/$defs/sha256"},
    "committed_at": {"type": "string", "format": "date-time"},
    "receipt_hash": {"$ref": "#/$defs/sha256"},
    "formal_writer": {"const": "JAVA_FINALIZER_ONLY"},
    "domain_commit_status": {"enum": ["COMMITTED", "ALREADY_COMMITTED"]}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
